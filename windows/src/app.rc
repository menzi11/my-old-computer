#include <windows.h>

#include "version.h"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MOC_VERSION_QUAD
 PRODUCTVERSION MOC_VERSION_QUAD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "menzi11"
            VALUE "FileDescription", "My Old Computer - a Windows 98 file manager"
            VALUE "FileVersion", MOC_VERSION_TEXT
            VALUE "InternalName", "MyOldComputer"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "MyOldComputer.exe"
            VALUE "ProductName", "My Old Computer"
            VALUE "ProductVersion", MOC_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
